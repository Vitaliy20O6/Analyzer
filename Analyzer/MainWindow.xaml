<Window x:Class="Analyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Analyzer"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="1200"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#0D1B2A">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <!-- Кастомный заголовок -->
            <RowDefinition/>
            <!-- Остальная часть окна -->
        </Grid.RowDefinitions>

        <!-- Кастомная верхняя панель -->
        <Grid Background="#1B263B"
              Grid.Row="0"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
              MouseMove="TitleBar_MouseMove"
              MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Code Analyzer"
                   VerticalAlignment="Center"
                   Margin="20 0 0 0"
                   Foreground="#E0E1DD"
                   FontSize="16"/>

            <!-- Кнопки окна -->
            <Button Content="—"
                    Width="40"
                    Height="30"
                    Margin="5 0 0 0"
                    Click="Minimize_Click"
                    Grid.Column="1"
                    Style="{StaticResource HoverButton}"
                    FontSize="16"
                    Padding="0"
                    VerticalContentAlignment="Center"/>

            <Button Content="▢"
                    Width="40"
                    Height="30"
                    Margin="5 0 5 0"
                    Click="Maximize_Click"
                    Grid.Column="2"
                    Style="{StaticResource HoverButton}"
                    FontSize="16"
                    Padding="0"
                    VerticalContentAlignment="Center"/>

            <Button Content="✕"
                    Width="40"
                    Height="30"
                    Margin="0 0 20 0"
                    Click="Close_Click"
                    Grid.Column="3"
                    Style="{StaticResource HoverButton}"
                    Background="#FF3B3B"
                    Foreground="White"
                    FontSize="16"
                    Padding="0"
                    VerticalContentAlignment="Center"/>
        </Grid>

        <Frame x:Name="MainFrame"
               NavigationUIVisibility="Hidden"
               Grid.Row="1"/>
    </Grid>
</Window>

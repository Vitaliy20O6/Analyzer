<Application x:Class="Analyzer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Analyzer"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        
        <!-- Общий стиль кнопки с эффектами -->
        <Style x:Key="HoverButton" TargetType="Button">
            <Setter Property="Background" Value="#415A77"/>
            <Setter Property="Foreground" Value="#E0E1DD"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontFamily" Value="Segoe UI Historic"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="10,6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#778DA9"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1B263B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--dfgfgh-->
        <Style x:Key="MenuRadioButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Segoe UI Historic"/>
            <Setter Property="Content" Value=""/>
            <Setter Property="Height" Value="50"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <!-- Вертикальная линия активной кнопки -->
                            <Border x:Name="ActiveLine"
                            Background="#E0E1DD"
                            CornerRadius="3"
                            Width="4"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed"/>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Иконка кнопки -->
                                <Image Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                               Width="48" Height="48" Margin="10,0,10,0"/>

                                <!-- Надпись кнопки -->
                                <TextBlock x:Name="Label"
                                   Text="{TemplateBinding Content}"
                                   Foreground="#E0E1DD"
                                   FontSize="18"
                                   FontFamily="Segoe UI Historic"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Линия отображается, когда кнопка активна -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ActiveLine" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- При наведении показывается надпись -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>

<Page x:Class="Analyzer.Pages.PatternsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Analyzer.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PatternsPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Индикатор загрузки -->
        <ProgressBar x:Name="LoadingIndicator" 
                 Grid.RowSpan="2"
                 Height="20"
                 IsIndeterminate="True"
                 Visibility="Collapsed"/>

        <!-- Список паттернов -->
        <ListView x:Name="PatternListView"
              Grid.Row="0"
              ItemsSource="{Binding DetectedPatterns}"
              SelectedItem="{Binding SelectedPattern, Mode=TwoWay}"
              SelectionChanged="PatternListView_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Паттерн" DisplayMemberBinding="{Binding PatternName}"/>
                    <GridViewColumn Header="Описание" DisplayMemberBinding="{Binding Description}"/>
                    <GridViewColumn Header="Статистика" DisplayMemberBinding="{Binding Summary}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Область визуализации -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Canvas x:Name="DiagramCanvas" Background="White" Width="1000" Height="1000"/>
        </ScrollViewer>
    </Grid>

</Page>

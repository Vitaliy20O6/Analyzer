<Page x:Class="Analyzer.Pages.MetricsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Analyzer.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MetricsPage"
      Background="#0D1B2A">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500" MinWidth="200"/>
            <ColumnDefinition Width="5"/>
            <!-- Splitter -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <RichTextBox Grid.Column="0"
                     x:Name="MetricsRichTextBox"
                     Background="LightGray"
                     FontFamily="Consolas"
                     FontSize="14"
                     IsReadOnly="True"
                     Margin="0 0 0 10"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     />

        <!-- Splitter между колонками -->
        <GridSplitter Grid.Column="1"
              Width="5"
              Margin="0 0 0 10"
              HorizontalAlignment="Stretch"
              Background="Gray"
              Panel.ZIndex="1"/>

        <RichTextBox Grid.Column="2"
                     x:Name="MetricsInfoRichTextBox"
                     Background="LightGray"
                     FontFamily="Consolas"
                     FontSize="14"
                     IsReadOnly="True"
                     Margin="0 0 0 10"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     />
    </Grid>
</Page>

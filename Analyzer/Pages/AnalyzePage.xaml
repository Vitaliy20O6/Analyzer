<Page x:Class="Analyzer.AnalyzePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Analyzer"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AnalyzePage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <!-- Меню с иконками -->
            <ColumnDefinition Width="*"/>
            <!-- Контент -->
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#1B263B"/>

        <!-- Меню -->
        <StackPanel Orientation="Vertical"
                    Grid.Column="0"
                    Margin="10 0 0 0"
                    VerticalAlignment="Top">

            <!-- Пример кнопки меню -->
            <RadioButton Style="{StaticResource MenuRadioButton}" 
             Tag="Images/structure.png" 
             Content="Структура" 
             GroupName="MenuGroup" 
             IsChecked="True" 
             Name="StructureButton"
                         Click="RadioButton_Checked"/>

            <RadioButton Style="{StaticResource MenuRadioButton}" 
             Tag="Images/methods.png" 
             Content="Методы" 
             GroupName="MenuGroup" 
             Name="MethodsButton"
                         Click="RadioButton_Checked"/>

            <RadioButton Style="{StaticResource MenuRadioButton}" 
             Tag="Images/infograph.png" 
             Content="Инфографика" 
             GroupName="MenuGroup" 
             Name="InfographButton"
                         Click="RadioButton_Checked"/>

            <RadioButton Style="{StaticResource MenuRadioButton}" 
             Tag="Images/patterns.png" 
             Content="Паттерны" 
             GroupName="MenuGroup" 
             Name="PatternsButton"
             Click="RadioButton_Checked"/>

        </StackPanel>

        <RadioButton Style="{StaticResource MenuRadioButton}" 
                     Tag="Images/home.png"
                     Content="На главную" 
                     GroupName="MenuGroup" 
                     Margin="10 0 0 10"
                     VerticalAlignment="Bottom"
                     Name="HomeButton"
                     Click="HomeButton_Click"/>

        <!-- Контентная область -->
        <Frame x:Name="ContentFrame"
               Grid.Column="1"
               NavigationUIVisibility="Hidden"/>
    </Grid>
</Page>

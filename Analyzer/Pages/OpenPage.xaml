<Page x:Class="Analyzer.OpenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Analyzer"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OpenPage">

    <Grid>
        <Border Background="#0D1B2A"/>

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="600">
            <Label Content="Укажите путь до проекта (*.sln | *.csproj)"
                   FontSize="18"
                   Foreground="#E0E1DD"
                   FontFamily="Segoe UI Historic"
                   HorizontalAlignment="Center"
                   Margin="0 0 0 20" />

            <TextBox x:Name="Path"
                     Height="40"
                     FontSize="18"
                     FontFamily="Segoe UI Historic"
                     Background="#1B263B"
                     Foreground="#778DA9"
                     BorderThickness="0"
                     TextAlignment="Center"
                     VerticalContentAlignment="Center"
                     VerticalAlignment="Center"
                     Margin="0 0 0 20" />

            <Button x:Name="Search"
                    Style="{StaticResource HoverButton}"
                    Content="Обзор"
                    HorizontalAlignment="Center" Click="Search_Click"/>
        </StackPanel>

    </Grid>
</Page>

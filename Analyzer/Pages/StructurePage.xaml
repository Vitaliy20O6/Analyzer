<Page x:Class="Analyzer.Pages.StructurePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="StructurePage"
      Background="#0D1B2A">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="200"/>
            <ColumnDefinition Width="5"/>
            <!-- Splitter -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- TreeView в первой колонке -->
        <Border Grid.Column="0" Background="#0D1B2A" BorderThickness="0">
            <TreeView x:Name="SolutionTreeView"
                    ItemsSource="{Binding RootNodes, Mode=OneWay}"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectedItemChanged="TreeView_SelectedItemChanged">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="Foreground" Value="#E0E1DD"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Icon}" 
                                   Width="16" 
                                   Height="16" 
                                   Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe UI"
                                       Foreground="#E0E1DD"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <!-- Splitter между колонками -->
        <GridSplitter Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      Background="Transparent"
                      Panel.ZIndex="1"/>

        <!-- AvalonEdit в третьей колонке -->
        <avalon:TextEditor Grid.Column="2"
                           BorderThickness="1"
                           x:Name="CodeEditor"
                           SyntaxHighlighting="C#"
                           FontFamily="Consolas"
                           FontSize="14"
                           ShowLineNumbers="True"
                           WordWrap="False"
                           IsReadOnly="True"
                           Background="LightGray"
                           LineNumbersForeground="#0D1B2A">
        </avalon:TextEditor>
    </Grid>
</Page>